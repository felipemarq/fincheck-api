# Variáveis locais usadas durante desenvolvimento e deploy.
# Os valores de Cognito são injetados pelo Serverless em tempo de deploy.

DATABASE_URL="postgresql://db_user:db_password@db-hostname.sa-east-1.aws.neon.tech/db_name?sslmode=require&channel_binding=require"
RECURRENCE_HORIZON_DAYS=90

# Opcional para custom domain / API Gateway
DISABLE_DEFAULT_APIGW_ENDPOINT=false
